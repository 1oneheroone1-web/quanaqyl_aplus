        "focus_valid_duration": {
          "name": "focus_valid_duration",
          "value": "\"focus_sessions\".\"focus_ms\" > 0 AND \"focus_sessions\".\"focus_ms\" <= \"focus_sessions\".\"planned_ms\" AND \"focus_sessions\".\"planned_ms\" BETWEEN 60000 AND 7200000"
        },
        "focus_valid_dates": {
          "name": "focus_valid_dates",
          "value": "\"focus_sessions\".\"ended_at\" >= \"focus_sessions\".\"started_at\" AND \"focus_sessions\".\"focus_ms\" <= \"focus_sessions\".\"ended_at\" - \"focus_sessions\".\"started_at\""
        },
        "focus_valid_completion": {
          "name": "focus_valid_completion",
          "value": "\"focus_sessions\".\"completed\" IN (0,1) AND (\"focus_sessions\".\"completed\" = 0 OR \"focus_sessions\".\"focus_ms\" = \"focus_sessions\".\"planned_ms\")"
        }
      }

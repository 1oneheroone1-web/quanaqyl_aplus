# Server only. Use the pooled connection string from Neon / Vercel Marketplace.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a unique random secret, at least 32 characters. Never commit its value.
BETTER_AUTH_SECRET=

# Local public origin, no trailing path. Do not copy localhost into Vercel.
# Optional on Vercel: production/deployment/branch URLs are detected automatically.
# Set BETTER_AUTH_URL explicitly for an additional custom domain.
BETTER_AUTH_URL=http://localhost:3000

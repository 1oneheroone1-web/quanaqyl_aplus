# Server only. Use the pooled connection string from Neon / Vercel Marketplace.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a unique random secret, at least 32 characters. Never commit its value.
BETTER_AUTH_SECRET=

# Public origin, no trailing path. Set your final Vercel or custom domain here.
BETTER_AUTH_URL=http://localhost:3000
